# ============================================
# SmartAttend AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/smartattend

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=SmartAttend AI
DEBUG=true

# AI Services (Phase 8 - leave empty for now)
# SARVAM_API_KEY=
# SARVAM_API_URL=

# LLM Service (Phase 8 - leave empty for now)
# LLM_API_KEY=
# LLM_API_URL=

# Telephony (Phase 8 - leave empty for now)
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SID=
# EXOTEL_CALLER_ID=
