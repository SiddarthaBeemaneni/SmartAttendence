# ============================================
# SmartAttend AI / CampusAI - Environment Variables
# ============================================

# Database (PostgreSQL with SQLite local dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartattend

# JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
APP_NAME=SmartAttend AI
DEBUG=false
FRONTEND_URL=http://localhost:5173

# Calling Mode: 'simulation' (requires zero provider credentials) or 'live'
CALL_MODE=simulation

# Exotel Telephony Configuration (Required only when CALL_MODE=live)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=

# Sarvam AI Voice & Speech Configuration (Required only when CALL_MODE=live)
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai

# Optional LLM API for advanced NLU reasoning
LLM_API_KEY=
LLM_API_URL=

# Background Job Queue (Optional - defaults to resilient embedded async queue)
REDIS_URL=

# Zoho ZeptoMail Configuration (For College Email OTP Verification)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_BOUNCE_ADDRESS=
ZEPTOMAIL_FROM_EMAIL=noreply@smartattend.edu
ZEPTOMAIL_FROM_NAME=SmartAttend AI - College Verification
